#pragma kernel CSMain
#pragma target 4.5
#pragma multi_compile _ _MAIN_LIGHT_SHADOWS
#pragma multi_compile _ _MAIN_LIGHT_SHADOWS_CASCADE
#pragma multi_compile _ _ADDITIONAL_LIGHT_SHADOWS
#pragma multi_compile _ _SHADOWS_SOFT
#pragma multi_compile _ _VL_DIRECT_LIGHTING
#pragma multi_compile _ _VL_ADDITIONAL_LIGHTS
#pragma multi_compile _ _VL_VOLUMETRIC_COOKIES

#include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Core.hlsl"
#include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Lighting.hlsl"
#include "Assets/Packages/VolumetricLighting/Resources/VolumetricLighting/VolumetricLightingCommon.hlsl"

struct VolumetricLightingAdditionalLight
{
    float4 position;
    float4 color;
    float4 attenuation;
    float4 spotDirection;
    float4 extraData;
};

struct VolumetricLightingCookieData
{
    float4x4 worldToCookie;
    float4 atlasRect;
};

TEXTURE2D_X(_CameraDepthTexture);
TEXTURE2D(_VolumetricLightingCookieAtlas);
SAMPLER(sampler_VolumetricLightingCookieAtlas);
RW_TEXTURE3D(float4, _VolumetricLightingFroxelTexture);
StructuredBuffer<VolumetricLightingAdditionalLight> _VolumetricLightingAdditionalLights;
StructuredBuffer<VolumetricLightingCookieData> _VolumetricLightingCookieData;

float4 _VolumetricLightingGridParams;
float4 _VolumetricLightingScreenSize;
float4 _VolumetricLightingVolumeParams;
float4x4 _VolumetricLightingInverseProjectionMatrix;
float4x4 _VolumetricLightingCameraToWorldMatrix;
float4 _VolumetricLightingMainLightDirection;
float4 _VolumetricLightingMainLightColor;
int _VolumetricLightingAdditionalLightCount;
int _VolumetricLightingCookieDataCount;

half3 SampleVolumetricCookie(int cookieIndex, float3 worldPosition)
{
#if defined(_VL_VOLUMETRIC_COOKIES)
    if (cookieIndex < 0 || cookieIndex >= _VolumetricLightingCookieDataCount)
        return half3(1.0, 1.0, 1.0);

    VolumetricLightingCookieData cookieData = _VolumetricLightingCookieData[cookieIndex];
    float4 cookiePosition = mul(cookieData.worldToCookie, float4(worldPosition, 1.0));
    if (cookiePosition.w <= VOLUMETRIC_LIGHTING_EPSILON)
        return half3(0.0, 0.0, 0.0);

    float2 cookieUv = saturate(cookiePosition.xy / cookiePosition.w * 0.5 + 0.5);
    float2 atlasUv = cookieUv * cookieData.atlasRect.xy + cookieData.atlasRect.zw;
    return SAMPLE_TEXTURE2D_LOD(
        _VolumetricLightingCookieAtlas,
        sampler_VolumetricLightingCookieAtlas,
        atlasUv,
        0.0).rgb;
#else
    return half3(1.0, 1.0, 1.0);
#endif
}

[numthreads(4, 4, 4)]
void CSMain(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    int3 grid = int3(_VolumetricLightingGridParams.xyz);
    if (any(dispatchThreadID >= grid))
        return;

    float nearDepth = _VolumetricLightingVolumeParams.x;
    float maxDistance = _VolumetricLightingVolumeParams.y;

    float2 uv = (float2(dispatchThreadID.xy) + 0.5) / max(_VolumetricLightingGridParams.xy, 1.0);
    uv.y = 1.0 - uv.y;
    float linearDepth = VolumetricLighting_SliceIndexToLinearDepth(dispatchThreadID.z, _VolumetricLightingGridParams.z, nearDepth, maxDistance);
    int2 pixelCoord = min(int2(uv * _VolumetricLightingScreenSize.xy), int2(_VolumetricLightingScreenSize.xy) - 1);

    float rawDepth = LOAD_TEXTURE2D_X(_CameraDepthTexture, pixelCoord).x;
    float sceneDepth = LinearEyeDepth(rawDepth, _ZBufferParams);
    if (!isfinite(sceneDepth) || sceneDepth <= 0.0)
        sceneDepth = maxDistance;
    sceneDepth = min(sceneDepth, maxDistance);

    float3 viewRay = VolumetricLighting_GetViewRay(uv, _VolumetricLightingInverseProjectionMatrix);
    float3 viewPosition = viewRay * linearDepth;
    float3 worldPosition = mul(_VolumetricLightingCameraToWorldMatrix, float4(viewPosition, 1.0)).xyz;

    float visibility = linearDepth <= (sceneDepth + 0.5) ? 1.0 : 0.0;
    half3 lighting = half3(0.0, 0.0, 0.0);

#if defined(_VL_DIRECT_LIGHTING)
    float shadowAttenuation = 1.0;

#if defined(_MAIN_LIGHT_SHADOWS) || defined(_MAIN_LIGHT_SHADOWS_CASCADE)
    float4 shadowCoord = TransformWorldToShadowCoord(worldPosition);
    shadowAttenuation = MainLightRealtimeShadow(shadowCoord);
#endif

    lighting += _VolumetricLightingMainLightColor.rgb * shadowAttenuation;
#endif

#if defined(_VL_ADDITIONAL_LIGHTS)
    [loop]
    for (int lightIndex = 0; lightIndex < _VolumetricLightingAdditionalLightCount; ++lightIndex)
    {
        VolumetricLightingAdditionalLight lightData = _VolumetricLightingAdditionalLights[lightIndex];
        float3 lightVector = lightData.position.xyz - worldPosition;
        float distanceSqr = max(dot(lightVector, lightVector), HALF_MIN);
        half3 lightDirection = half3(lightVector * rsqrt(distanceSqr));
        float attenuation = DistanceAttenuation(distanceSqr, lightData.attenuation.xy);

        if (lightData.extraData.y > 0.5)
            attenuation *= AngleAttenuation(lightData.spotDirection.xyz, lightDirection, lightData.attenuation.zw);

        half3 cookieColor = SampleVolumetricCookie((int)lightData.extraData.z, worldPosition);

        #if defined(_ADDITIONAL_LIGHT_SHADOWS)
        half additionalShadow = AdditionalLightRealtimeShadow((int)lightData.extraData.x, worldPosition, lightDirection);
        #else
        half additionalShadow = half(1.0);
        #endif

        lighting += lightData.color.rgb * cookieColor * (attenuation * additionalShadow);
    }
#endif

    _VolumetricLightingFroxelTexture[dispatchThreadID] = float4(lighting * visibility, visibility);
}
